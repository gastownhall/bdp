  "appendixE": [
    {
      "number": 1,
      "statement": "A stable identity per resource \u2014 never reused, never changed; opaque local part.",
      "checks": ["core.inventory", "core.stability"]
    },
    {
      "number": 2,
      "statement": "A type per resource \u2014 the (authority, type) pair, frozen at inception.",
      "checks": ["core.representations", "core.stability"]
    },
    {
      "number": 3,
      "statement": "A body and metadata it stores and does NOT interpret.",
      "checks": ["core.point-read", "core.stability"]
    },
    {
      "number": 4,
      "statement": "A storage class per resource \u2014 Durable | Ephemeral | Intrinsic; whether",
      "checks": ["core.representations", "core.restart"]
    },
    {
      "number": 5,
      "statement": "A revision per resource that changes exactly when its state changes.",
      "checks": ["core.point-read", "core.stability"]
    },
    {
      "number": 6,
      "statement": "History where offered \u2014 prior revisions addressable; offered or not, discoverable.",
      "checks": ["core.discovery", "core.history"]
    },
    {
      "number": 7,
      "statement": "A transaction marker shared by everything committed together.",
      "checks": ["core.read-only"],
      "appliesWhen": "unoffered-write"
    },
    {
      "number": 8,
      "statement": "A cause minted once per incoming request, stamped on every effect it sets off.",
      "checks": ["core.context", "stdlib.query"]
    },
    {
      "number": 9,
      "statement": "A durable change record per resource per commit \u2014 none for a failed or no-change request.",
      "checks": ["core.read-only"],
      "appliesWhen": "unoffered-write"
    },
    {
      "number": 10,
      "statement": "Provenance saved with the change, immutable, never invented.",
      "checks": ["core.representations", "core.read-only"]
    },
    {
      "number": 11,
      "statement": "A changefeed at /sys/changes carrying every commit (replication included).",
      "checks": ["core.feed", "core.safe-reads"]
    },
    {
      "number": 12,
      "statement": "An export consistent with itself, with the cursor that matches it.",
      "checks": ["core.export"]
    },
    {
      "number": 13,
      "statement": "An authorization view \u2014 a hidden resource reads exactly as a missing one.",
      "checks": ["core.absence"]
    },
    {
      "number": 14,
      "statement": "Deletion that does not erase \u2014 the id stays accounted for, the tombstone is kept.",
      "checks": ["core.read-only"],
      "appliesWhen": "unoffered-write"
    }
  ]
}
