  "appendixE": [
    {
      "number": 1,
      "statement": "A stable identity per resource — never changed, and under `permanent` never reused; opaque local part. Under `reusable` a retired id MAY be minted again, which is what that model declares.",
      "checks": [
        "core.inventory",
        "core.stability"
      ]
    },
    {
      "number": 2,
      "statement": "A type per resource — the (authority, type) pair, frozen at inception.",
      "checks": [
        "core.representations",
        "core.stability"
      ]
    },
    {
      "number": 3,
      "statement": "A body and metadata it stores and does NOT interpret.",
      "checks": [
        "core.point-read",
        "core.stability"
      ]
    },
    {
      "number": 4,
      "statement": "A storage class per resource — Durable | Ephemeral | Intrinsic; whether revisions are kept is the scope revisionModel, not a per-resource field.",
      "checks": [
        "core.representations",
        "core.restart"
      ]
    },
    {
      "number": 5,
      "statement": "Under `versioned`, a revision per resource that changes exactly when its state changes. Under `unversioned` no revision is minted and `rev` is absent everywhere, so this guarantee is vacuous rather than violated.",
      "checks": [
        "core.point-read",
        "core.stability"
      ]
    },
    {
      "number": 6,
      "statement": "History where offered — prior revisions addressable; offered or not, discoverable.",
      "checks": [
        "core.discovery",
        "core.history"
      ]
    },
    {
      "number": 7,
      "statement": "A transaction marker shared by everything committed together.",
      "checks": [
        "core.read-only"
      ],
      "appliesWhen": "unoffered-write"
    },
    {
      "number": 8,
      "statement": "A cause minted once per incoming request, stamped on every effect it sets off.",
      "checks": [
        "core.context",
        "stdlib.query"
      ]
    },
    {
      "number": 9,
      "statement": "A durable change record per resource per commit — none for a failed or no-change request.",
      "checks": [
        "core.read-only"
      ],
      "appliesWhen": "unoffered-write"
    },
    {
      "number": 10,
      "statement": "Provenance saved with the change, immutable, never invented.",
      "checks": [
        "core.representations",
        "core.read-only"
      ]
    },
    {
      "number": 11,
      "statement": "A changefeed at /sys/changes carrying every commit (replication included).",
      "checks": [
        "core.feed",
        "core.safe-reads"
      ]
    },
    {
      "number": 12,
      "statement": "Where `export` is offered, an export consistent with itself, with the cursor that matches it.",
      "checks": [
        "core.export"
      ]
    },
    {
      "number": 13,
      "statement": "An authorization view — a hidden resource reads exactly as a missing one.",
      "checks": [
        "core.absence"
      ]
    },
    {
      "number": 14,
      "statement": "Where `delete` is offered, deletion that does not erase — under `permanent` the id stays accounted for, and where the scope is also `versioned` the tombstone revision is kept. A `reusable` scope retains neither record; that is the declared model, not a breach of this guarantee.",
      "checks": [
        "core.read-only"
      ],
      "appliesWhen": "unoffered-write"
    }
  ],
  "trackingIssues": {
    "gastownhall/bdp#443": "Untracked read-coverage cases: Alias#2 resolution overlay (aliases-gated) and selector#1 baseline params (?include/?omit/?expand)."
  }
