                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "typeSelector": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "anyOf"
                  ],
                  "properties": {
                    "anyOf": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/typeReference"
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "any"
                  ],
                  "properties": {
                    "any": {
                      "const": true
                    }
                  },
                  "additionalProperties": false
                }
              ],
              "$comment": "Candidate OR selector syntax, not JSON Schema anyOf evaluation. Exact/floating matching remains a product decision; any:true imposes no Type restriction."
