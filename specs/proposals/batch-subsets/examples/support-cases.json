[
  {
    "name": "six-supported-records",
    "request": {
      "operations": [
        {
          "operation": "createBead",
          "type": "https://example.invalid/types/task",
          "properties": {
            "title": "Example"
          }
        },
        {
          "operation": "updateBead",
          "bead": "https://example.invalid/s/beads/a",
          "propertiesChange": [
            {
              "op": "replace",
              "path": "/title",
              "value": "Changed"
            }
          ]
        },
        {
          "operation": "deleteBead",
          "bead": "https://example.invalid/s/beads/a"
        },
        {
          "operation": "createLink",
          "type": "https://example.invalid/types/association",
          "source": "https://example.invalid/s/beads/a",
          "target": "https://example.invalid/s/beads/b"
        },
        {
          "operation": "updateLink",
          "link": "https://example.invalid/s/links/l",
          "propertiesChange": [
            {
              "op": "add",
              "path": "/note",
              "value": "Changed"
            }
          ]
        },
        {
          "operation": "deleteLink",
          "link": "https://example.invalid/s/links/l"
        }
      ]
    },
    "expected": {
      "classification": "supported-shape"
    }
  },
  {
    "name": "unsupported-index-0",
    "request": {
      "operations": [
        {
          "operation": "deleteWhere",
          "collection": "beads",
          "selector": "$[*]"
        },
        {
          "operation": "createBead",
          "type": "https://example.invalid/types/task",
          "properties": {
            "title": "Example"
          }
        },
        {
          "operation": "updateBead",
          "bead": "https://example.invalid/s/beads/a",
          "propertiesChange": [
            {
              "op": "replace",
              "path": "/title",
              "value": "Changed"
            }
          ]
        }
      ]
    },
    "expected": {
      "classification": "unsupported",
      "pointer": "/operations/0/operation",
      "operation": "deleteWhere"
    }
  },
  {
