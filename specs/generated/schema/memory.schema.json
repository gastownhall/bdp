{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gastownhall/bdp/specs/generated/schema/memory.schema.json",
  "$defs": {
    "markdown": {
      "description": "Markdown text — a nominal string (lowers to a nominal over string).",
      "type": "string"
    },
    "Memory": {
      "description": "Memory — a unit of arbitrary knowledge. Plain memories exist and packs refine subtypes.",
      "allOf": [
        {
          "$ref": "core.schema.json#/$defs/Bead"
        },
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "$ref": "#/$defs/markdown"
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "references": {
              "type": "array",
              "items": {
                "$ref": "core.schema.json#/$defs/ResourceRef"
              }
            },
            "supersededBy": {
              "type": "array",
              "items": {
                "$ref": "core.schema.json#/$defs/ResourceRef"
              }
            },
            "subjectTo": {
              "type": "array",
              "items": {
                "$ref": "core.schema.json#/$defs/ResourceRef"
              }
            }
          },
          "required": [
            "title",
            "body",
            "references",
            "supersededBy",
            "subjectTo"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Constraint": {
      "description": "Constraint — an obligation. Abstract: only the concrete subtypes below are instantiated.",
      "allOf": [
        {
          "$ref": "#/$defs/Memory"
        },
        {
          "type": "object",
          "properties": {
            "requires": {
              "type": "array",
              "items": {
                "$ref": "core.schema.json#/$defs/ResourceRef"
              }
            },
            "defines": {
              "type": "array",
              "items": {
                "$ref": "core.schema.json#/$defs/ResourceRef"
              }
            },
            "definedBy": {
              "type": "array",
              "items": {
                "$ref": "core.schema.json#/$defs/ResourceRef"
              }
            }
          },
          "required": [
            "requires",
            "defines",
            "definedBy"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Policy": {
      "allOf": [
        {
          "$ref": "#/$defs/Constraint"
        },
        {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      ]
    },
    "Requirement": {
      "allOf": [
        {
          "$ref": "#/$defs/Constraint"
        },
        {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      ]
    },
    "Scenario": {
      "allOf": [
        {
          "$ref": "#/$defs/Constraint"
        },
        {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      ]
    },
    "Specification": {
      "description": "Specification — an intended result, described well enough to be checked against.",
      "allOf": [
        {
          "$ref": "#/$defs/Constraint"
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Evaluation": {
      "description": "Evaluation — an assessment over a NONEMPTY group of subject resources.",
      "allOf": [
        {
          "$ref": "#/$defs/Memory"
        },
        {
          "type": "object",
          "properties": {
            "subjects": {
              "type": "array",
              "items": {
                "$ref": "core.schema.json#/$defs/ResourceRef"
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "conformance": {
              "type": "array",
              "items": {
                "$ref": "core.schema.json#/$defs/ResourceRef"
              }
            }
          },
          "required": [
            "subjects",
            "conformance"
          ],
          "additionalProperties": false
        }
      ]
    },
    "References": {
      "description": "References — a relationship from a bead to useful context, carried as a first-class edge resource. The root of this pack's relationship family and the only one that is itself unowned.",
      "allOf": [
        {
          "$ref": "core.schema.json#/$defs/rel"
        },
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "body": {
              "$ref": "#/$defs/markdown",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "SupersededBy": {
      "description": "SupersededBy — retires a Memory in favour of a replacement with a different identity. Source is the retiring bead, target its replacement.",
      "$comment": "UNLOWERED: References, acyclic rel<Memory, Memory> {}"
    },
    "Requires": {
      "description": "Requires — says the target Constraint is necessary for satisfying the source Constraint.",
      "$comment": "UNLOWERED: References rel<Constraint, Constraint> {}"
    },
    "Defines": {
      "description": "Defines — makes the source Constraint the DEFINING PARENT of the target, and inherits Requires' necessity. Source is the parent, target the child.",
      "$comment": "UNLOWERED: Requires, acyclic rel<Constraint, Constraint> {}"
    },
    "SubjectTo": {
      "description": "SubjectTo — declares that the target Constraint applies to the source bead. Source is the SUBJECT, which is the end that owns the declaration.",
      "$comment": "UNLOWERED: References rel<Bead, Constraint> {}"
    },
    "Conformance": {
      "description": "Conformance — the abstract claim family: a claim by the source Evaluation about its FULL assessed subject group relative to the target Constraint. Abstract, so only the three concrete peers below are instantiated.",
      "$comment": "UNLOWERED: References rel<Evaluation, Constraint> {\n  evidence?: text { minLength: 1 },\n}"
    },
    "Addresses": {
      "allOf": [
        {
          "$ref": "#/$defs/Conformance"
        },
        {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      ]
    },
    "Satisfies": {
      "allOf": [
        {
          "$ref": "#/$defs/Conformance"
        },
        {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      ]
    },
    "Violates": {
      "allOf": [
        {
          "$ref": "#/$defs/Conformance"
        },
        {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      ]
    },
    "RememberError": {
      "description": "Domain refusals of `rememberMemory`.",
      "enum": [
        "already-exists",
        "not-a-memory",
        "identity-consumed"
      ]
    },
    "ForgetError": {
      "description": "Domain refusals of `forgetMemory`.",
      "enum": [
        "has-incident-links",
        "not-a-memory"
      ]
    },
    "MemorySummary": {
      "description": "MemorySummary — one row of the compact summary view: identity, title, a bounded body excerpt, and the optional `details` fields.",
      "type": "object",
      "properties": {
        "memory": {
          "$ref": "core.schema.json#/$defs/ResourceRef"
        },
        "title": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "type": {
          "$ref": "core.schema.json#/$defs/PathString"
        },
        "revision": {
          "$ref": "core.schema.json#/$defs/Rev"
        },
        "createdBy": {
          "type": "string"
        },
        "linkCount": {
          "type": "integer"
        }
      },
      "required": [
        "memory",
        "title",
        "excerpt",
        "type"
      ],
      "additionalProperties": false
    },
    "ReferenceError": {
      "description": "Domain refusals of `createReference`.",
      "enum": [
        "ineligible-endpoints",
        "self-link"
      ]
    },
    "SupersedeError": {
      "description": "Domain refusals of `supersedeMemory`.",
      "enum": [
        "ineligible-endpoints",
        "self-link",
        "already-superseded",
        "would-cycle"
      ]
    },
    "RequiresError": {
      "description": "Domain refusals of `createRequires`.",
      "enum": [
        "ineligible-endpoints",
        "self-link"
      ]
    },
    "DefinesError": {
      "description": "Domain refusals of `createDefines`.",
      "enum": [
        "ineligible-endpoints",
        "self-link",
        "already-defined",
        "would-cycle"
      ]
    },
    "SubjectToError": {
      "description": "Domain refusals of `createSubjectTo`.",
      "enum": [
        "ineligible-endpoints",
        "self-link",
        "source-lacks-ownership"
      ]
    }
  }
}
