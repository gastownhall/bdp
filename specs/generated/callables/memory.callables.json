      "path": "memory/reference",
      "operation": "createReference",
      "safe": false,
      "idempotent": false,
      "cli": "reference",
      "summary": "Create a References Link from a Bead to useful context (unowned; §1.3.1)",
      "parameters": [
        {
          "name": "source",
          "type": "ref<Bead>",
          "required": true
        },
        {
          "name": "target",
          "type": "ref<resource>",
          "required": true
        },
        {
          "name": "title",
          "type": "string",
          "required": false
        },
        {
          "name": "body",
          "type": "markdown",
          "required": false
        },
        {
          "name": "status",
          "type": "string",
          "required": false
        }
      ],
      "returns": "rep<References>",
      "errors": [
        "ReferenceError"
      ]
    },
