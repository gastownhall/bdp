{
  "_comment": "Nonnormative BDP encoding of the project-driven Memory vocabulary: eight Bead definitions and the generic references Link. Illustrative namespaces/revisions, not production identity allocation or adoption. Property copies mirror owned schemas. No runtime or endpoint qualification.",
  "definitions": [
    {
      "id": "https://example.org/memory-types/memory",
      "revision": "memory-contract-1",
      "type": {
        "uri": "https://example.org/types/beads/bead-type",
        "revision": "bead-type-1"
      },
      "properties": {
        "description": "Common Memory contract: title/body and optional open-string status.",
        "propertiesSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://example.org/memory-types/schemas/memory.properties.schema.json",
          "title": "Memory properties",
          "$comment": "Memory V1 product property contract, not a BDP Type representation or complete mutation validator. Explicit Type supplies meaning; body is primary. Applicability/validity context stays in application metadata. Status is an optional open string; existing additional properties are preserved.",
          "type": "object",
          "required": ["title", "body"],
          "properties": {
            "title": {
              "type": "string",
              "pattern": "\\S"
            },
            "body": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "pattern": "\\S",
              "description": "Optional author-reported status. Open vocabulary, no default or automatic workflow, approval, truth or visibility effect."
            }
          },
          "additionalProperties": true
        },
        "ownsOutgoing": [
          {
            "any": true
          }
        ]
      },
      "ownedLinks": {
        "https://example.org/types/beads/conforms-to": []
      }
    },
    {
      "id": "https://example.org/memory-types/policy",
      "revision": "policy-contract-1",
      "type": {
        "uri": "https://example.org/types/beads/bead-type",
        "revision": "bead-type-1"
      },
      "properties": {
        "description": "A governing rule for how the project operates.",
        "propertiesSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://example.org/memory-types/schemas/memory-policy.local-properties.schema.json",
          "title": "Policy local properties requirements",
          "$comment": "Memory Release specialization fragment. Also validate the common Memory schema. Body carries primary content; optional properties add distinct information. Empty body remains representable with an explicit title.",
          "type": "object",
          "properties": {
            "authority": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "object",
                  "required": ["uri", "revision"],
                  "properties": {
                    "uri": {
                      "type": "string",
                      "format": "uri"
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              ],
              "$comment": "Reuses only the Core Reference value shape. This property is authored data, not a protocol Reference or graph edge; no Core canonicalization, resolution, traversal or target validation. Opaque external URIs are allowed."
            }
          },
          "additionalProperties": true
        }
      },
      "ownedLinks": {
        "https://example.org/types/beads/conforms-to": [
