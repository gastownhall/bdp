{
  "_comment": "Illustrative final-state domain literals, not a package/import API or installation transaction. Twelve definitions, five owned exact ConformsTo declarations. Foundation identities refer to the shared example; registry/Scope admission and revision allocation remain open. No runtime or wire acceptance claim.",
  "definitions": [
    {
      "id": "https://example.org/memory-types/memory",
      "revision": "memory-contract-1",
      "type": {
        "uri": "https://example.org/types/beads/bead-type",
        "revision": "bead-type-1"
      },
      "properties": {
        "description": "Memory domain contract; see Memory specification.",
        "propertiesSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://example.org/memory-types/schemas/memory.properties.schema.json",
          "title": "Memory properties",
          "$comment": "WIP domain schema; known fields refine Memory R3. Shape is not lifecycle/Type admission. No domain kind discriminator.",
          "type": "object",
          "required": ["title", "body"],
          "properties": {
            "title": {
              "type": "string",
              "pattern": "\\S"
            },
            "body": {
              "type": "string"
            },
            "kind": false,
            "inception": {
              "type": "object",
              "required": ["method"],
              "properties": {
                "method": {
                  "enum": ["native", "converted", "imported", "unknown"]
                },
                "origin": {
                  "oneOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "object",
                      "required": ["uri", "revision"],
                      "properties": {
                        "uri": {
                          "type": "string",
                          "format": "uri"
                        },
                        "revision": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  ],
                  "$comment": "Reuses only the Core Reference value shape. This property is authored data, not a protocol Reference or graph edge; no Core canonicalization, resolution, traversal or target validation. Opaque external URIs are allowed."
                }
              },
              "additionalProperties": false
            },
            "applicability": {
              "type": "object",
              "required": ["description"],
              "properties": {
                "description": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "validFrom": {
                  "type": "string",
                  "format": "date-time"
                },
                "validUntil": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "additionalProperties": false,
              "$comment": "Interval ordering is a separate domain admission check; no truth or clock-driven lifecycle claim."
            }
          },
          "additionalProperties": true
        },
        "ownsOutgoing": [
          {
            "any": true
          }
        ]
      },
      "ownedLinks": {
        "https://example.org/types/beads/conforms-to": []
      }
    },
