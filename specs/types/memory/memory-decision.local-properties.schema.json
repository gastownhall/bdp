{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/memory-types/schemas/memory-decision.local-properties.schema.json",
  "title": "Decision local properties requirements",
  "$comment": "Local fragment only. Complete validation also applies the exact Memory contract through owned ConformsTo; this fragment alone is insufficient.",
  "type": "object",
  "required": ["choice"],
  "properties": {
    "choice": {
      "type": "string",
      "pattern": "\\S"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  },
  "additionalProperties": true
}
