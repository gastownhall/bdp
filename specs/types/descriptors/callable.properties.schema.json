{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gastownhall/bdp/schemas/types/callable.properties.schema.json",
  "title": "Callable declaration",
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "description": { "type": "string" },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "schema": true,
          "required": { "type": "boolean" },
          "default": true,
          "description": { "type": "string" }
        },
        "required": ["name", "schema"],
        "additionalProperties": false
      }
    },
    "resultSchema": true,
    "errorSchema": true,
    "modes": {
      "type": "array",
      "items": { "enum": ["sync", "async"] },
      "uniqueItems": true
    }
  },
  "required": ["parameters", "resultSchema", "errorSchema"],
  "additionalProperties": true
}
