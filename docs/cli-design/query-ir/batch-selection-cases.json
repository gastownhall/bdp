  "runtimeObligations": [
    {
      "id": "fixed-membership-fresh-content",
      "scenario": "Capture {A,B}; update B out of the original predicate; List the prior set under the new property predicate.",
      "expected": "A new set can contain B under its updated fields. Original membership remains {A,B}; no implicit re-query of its original predicate."
    },
    {
      "id": "deleted-captured-member",
      "scenario": "Capture {A,B}; delete B; use the prior set as required candidates/roots.",
      "expected": "Require live resolution; refuse rather than silently remove B or acquire a historical edition."
    },
    {
      "id": "foreign-required-endpoint",
      "scenario": "A local Link carries an opaque foreign target; Query asks for target fields or expands there.",
      "expected": "Refuse the required acquisition. A Link-only selection may preserve the opaque stored Reference without acquiring it."
    },
    {
      "id": "no-staged-edition-token",
      "scenario": "Create/update a Bead, then select its id and application properties.",
      "expected": "Read current staged content without inventing a public revision."
    },
    {
      "id": "read-only-atomic-selection",
      "scenario": "Execute List/Query selection members without mutations.",
      "expected": "Read-only batches are allowed under the selected serializable logical execution rule; results/recovery use the Batch contract."
    },
    {
      "id": "independent-selection-capabilities",
      "scenario": "Provider advertises transaction List only; submit a transaction Query.",
      "expected": "Refuse unsupported selection before effects; standalone Query support does not establish transaction Query support."
    }
  ],
  "priorBindings": {
    "notes": {
