      "request": {
        "method": "POST",
        "target": "operations/sequence",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json"
        },
        "schema": "#/$defs/sequenceRequest",
        "body": {
          "operations": [
            {
              "idempotencyKey": "w1-note-create",
              "operation": "createBead",
              "name": "note",
              "type": "https://work.example/types/decision",
              "properties": {
                "title": "A different decision under a reused key",
                "status": "proposed"
              },
              "attribution": { "principal": "agent:planner", "status": "claimed" }
            },
            {
              "idempotencyKey": "w1-task-7-status",
              "operation": "updateBeadProperties",
              "bead": "beads/task-7",
              "change": [{ "op": "replace", "path": "/status", "value": "closed" }],
              "attribution": { "principal": "agent:planner", "status": "claimed" }
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "private, no-store"
        },
        "schema": "#/$defs/sequenceResponse",
        "body": {
          "results": [
            {
              "type": "https://github.com/gastownhall/bdp/problems/conflict",
              "code": "idempotency-conflict",
              "status": 409,
              "retry": "never",
              "operationIndex": 0,
              "operationName": "note",
              "detail": "w1-note-create is retained with a different semantic identity"
            },
            {
              "operationIndex": 1,
              "outcome": "updated",
              "resource": {
                "id": "https://beads.example/acme/beads/task-7",
                "type": "https://work.example/types/task",
                "revision": "task-7-r3",
                "attribution": { "principal": "agent:planner", "status": "claimed" },
                "properties": {
                  "title": "Review the retention ruling",
                  "status": "closed",
                  "priority": 2
                }
              }
            }
          ]
        }
      }
    },
