        "schema": "#/$defs/aliasResult",
        "body": {
          "outcome": "created",
          "alias": "https://beads.example/acme/alias/adr/sequence-envelopes",
          "target": "https://beads.example/acme/beads/decision-7"
        }
      }
    },
