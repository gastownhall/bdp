    {
      "id": "create-bead-on-a-live-alias-path",
      "condition": "alias/adr/sequence-envelopes is live. Canonical Bead segments and alias paths share one uniqueness namespace, so a Bead creation supplying the same path is refused — with alias-path-taken, not identity-taken: the path is held by an alias, not by a committed identity, and once the alias is deleted the identical creation succeeds, which is what after-state-change tells the client.",
      "request": {
        "method": "POST",
        "target": "operations/create-bead",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json",
          "idempotency-key": "w1-a-envelopes-collide"
        },
        "schema": "#/$defs/createBeadRequest",
        "body": {
          "id": "beads/adr/sequence-envelopes",
          "type": "https://work.example/types/decision",
          "properties": { "title": "Collide with a live alias", "status": "proposed" }
        }
      },
      "response": {
        "status": 409,
        "headers": {
          "content-type": "application/problem+json",
          "cache-control": "private, no-store"
        },
        "schema": "#/$defs/readUpdateProblem",
        "body": {
          "type": "https://github.com/gastownhall/bdp/problems/conflict",
          "code": "alias-path-taken",
          "status": 409,
          "retry": "after-state-change",
          "detail": "adr/sequence-envelopes is held by a live alias; the path is free for a creation once the alias is deleted"
        }
      }
    },
