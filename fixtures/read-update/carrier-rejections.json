{
  "fixtureVersion": 1,
  "id": "read-update-carrier-rejections",
  "description": "Direct rejections of the sequence carrier before execution: a repeated key, a repeated name, an invalid name, an invalid key, a malformed later member, an unknown, forward, or wrong-kind @name reference (decidable from the request text, as in a batch), a stray Idempotency-Key field, and a member count above the advertised sequence.operations. Each is a direct problem response that executes nothing, so no member — not even a well-formed first one — commits and no key is claimed. Request bodies the bundle rejects carry no request schema. Illustrative wire example; not evidence.",
  "scope": "https://beads.example/acme/",
  "exchanges": [
    {
      "id": "repeated-key",
      "request": {
        "method": "POST",
        "target": "operations/sequence",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json"
        },
        "schema": "#/$defs/sequenceRequest",
        "body": {
          "operations": [
            {
              "idempotencyKey": "w1-dup-key",
              "operation": "createBead",
              "name": "first",
              "type": "https://work.example/types/task",
              "properties": {
                "title": "First",
                "status": "open"
              },
              "attribution": {
                "principal": "agent:planner",
                "status": "claimed"
              }
            },
            {
              "idempotencyKey": "w1-dup-key",
              "operation": "createBead",
              "type": "https://work.example/types/task",
              "properties": {
                "title": "Second",
                "status": "open"
              },
              "attribution": {
                "principal": "agent:planner",
                "status": "claimed"
              }
            }
          ]
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "content-type": "application/problem+json",
          "cache-control": "private, no-store"
        },
        "schema": "#/$defs/readUpdateProblem",
        "body": {
          "type": "https://github.com/gastownhall/bdp/problems/request",
          "code": "malformed-request",
          "status": 400,
          "retry": "never",
          "detail": "idempotencyKey w1-dup-key is repeated within the sequence"
        }
      }
    },
