    {
      "id": "malformed-later-member",
      "condition": "Member 0 is well-formed; member 1 omits its required bead. The carrier is rejected as a whole before member 0 starts.",
      "request": {
        "method": "POST",
        "target": "operations/sequence",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json"
        },
        "body": {
          "operations": [
            {
              "idempotencyKey": "w1-well-formed-first",
              "operation": "createBead",
              "name": "first",
              "type": "https://work.example/types/task",
              "properties": {
                "title": "First",
                "status": "open"
              },
              "attribution": {
                "principal": "agent:planner",
                "status": "claimed"
              }
            },
            {
              "idempotencyKey": "w1-malformed-second",
              "operation": "updateBeadProperties",
              "change": [
                {
                  "op": "replace",
                  "path": "/status",
                  "value": "closed"
                }
              ]
            }
          ]
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "content-type": "application/problem+json",
          "cache-control": "private, no-store"
        },
        "schema": "#/$defs/readUpdateProblem",
        "body": {
          "type": "https://github.com/gastownhall/bdp/problems/request",
          "code": "malformed-request",
          "status": 400,
          "retry": "never",
          "detail": "operations[1] is not a valid updateBeadProperties record: bead is required"
        }
      }
    },
    {
      "id": "unknown-binding",
      "condition": "@adr is declared by no member of this sequence — bindings are confined to one request — and that is decidable from the request text, so the carrier is rejected before member 0 starts.",
      "request": {
        "method": "POST",
        "target": "operations/sequence",
        "headers": { "content-type": "application/json", "accept": "application/json" },
        "schema": "#/$defs/sequenceRequest",
        "body": {
          "operations": [
            {
              "idempotencyKey": "w1-first-before-orphan",
              "operation": "createBead",
              "name": "first",
              "type": "https://work.example/types/task",
              "properties": { "title": "First", "status": "open" },
              "attribution": { "principal": "agent:planner", "status": "claimed" }
            },
            {
              "idempotencyKey": "w1-orphan-cite",
              "operation": "createLink",
              "type": "https://work.example/types/cites",
              "source": "@adr",
              "target": "https://github.example/issues/124",
              "properties": {},
              "attribution": { "principal": "agent:planner", "status": "claimed" }
            }
          ]
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "content-type": "application/problem+json",
          "cache-control": "private, no-store"
        },
        "schema": "#/$defs/readUpdateProblem",
        "body": {
          "type": "https://github.com/gastownhall/bdp/problems/request",
          "code": "malformed-request",
          "status": 400,
          "retry": "never",
          "detail": "operations[1] references @adr, which no earlier member of this sequence declares"
        }
      }
    },
