  "semanticCases": [
    {
      "id": "required-mode",
      "expect": "Every source offers postimage; delta support does not remove it."
    },
    {
      "id": "optional-delta",
      "expect": "Unsupported delta selection refuses before any data; no postimage fallback."
    },
    {
      "id": "typed-only",
      "expect": "A changed affiliation emits a truthful update with no fake patch."
    },
    {
      "id": "unchanged-type",
      "expect": "Same resolved state under selected publication model is a no-op, not provenance-forced change."
    },
    {
      "id": "realized-state",
      "expect": "Delta edits yield actual published next state, not a blind echo of requested edits."
    },
    {
      "id": "two-singletons",
      "expect": "Separately committed A-to-B then B-to-C retain both facts and their own postimages."
    },
    {
      "id": "batch-final-publication",
      "expect": "Selected atomic final publication: at most one new revision/fact per affected Resource; net-zero keeps revisions/key outcome, allocation remains a durable effect."
    },
    {
      "id": "owner-carrier",
      "expect": "Given an actual published owner transition, derived map records bucket entry/exit, empty owner or non-owner; fixture does not allocate revisions."
    },
    {
      "id": "owned-correlation",
      "expect": "Actual Link and owner transitions share known commit correlation without equal revision tokens or duplicate mutation application."
    },
    {
      "id": "link-delete",
      "expect": "Delete retains final identity/type/endpoints, no properties/new revision."
    },
    {
      "id": "incident-self",
      "expect": "Bead projection includes the incident Link fact once for a self-Link, without endpoint versioning."
    },
    {
      "id": "external-start",
      "expect": "Baseline discovery of an existing record is not a fake original creation."
    },
    {
      "id": "external-observation",
      "expect": "A sampled source declares intermediate-loss limitations; no invented original mutation sequence or commit time."
    },
    {
      "id": "empty-static",
      "expect": "A truthful empty covered static interval is valid and resumable."
    },
    {
      "id": "replay-floor",
      "expect": "A new retained start may begin at current floor; an expired continuation never silently starts there."
    },
    {
      "id": "retention-promise",
      "expect": "Issued cursor context/remaining range and admitted Event promises survive ordinary config changes for their stated lifetimes."
    },
    {
      "id": "fixed-bound",
      "expect": "Next pages retain captured head/context/limit; new changes arrive through a later after traversal."
    },
    {
      "id": "gap",
      "expect": "Observation loss or replaced history yields foreign-view without false caught-up success."
    },
    {
      "id": "reset-ahead",
      "expect": "Old ahead-of-head cursor cannot silently appear drained after source restore."
    },
    {
      "id": "partial-output",
      "expect": "Do not report page cursor until every Event was validated and emitted; last complete page may safely redeliver data."
    },
    {
      "id": "unknown-required",
      "expect": "Stop before incompatible fact and retain last good consumer progress."
    },
    {
      "id": "optional-annotation",
      "expect": "Only the declared annotations area is ignorable; new capabilities preserve every selected base effect."
    },
    {
      "id": "erasure",
      "expect": "Authorization/controlled-content erasure are enforced; no fake complete retained postimage or replica-erasure claim."
    },
    {
      "id": "live-poll",
      "expect": "Follow drains fixed ranges then polls same JSON source; no independent SSE log or public epoch."
    },
    {
      "id": "observed-predecessor",
      "expect": "Observed r1-to-r4 spans complete known samples; no invented r3 predecessor, original mutation count or transaction."
    },
    {
      "id": "observed-disappearance",
      "expect": "Confirmed absence reports last-observed r4 identity/context under observation origin and observed policy; unknown backend-final state is not invented. Missing required prior context or unconfirmed absence refuses without cursor advance."
    }
  ],
