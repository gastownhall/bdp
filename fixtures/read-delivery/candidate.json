  "semanticCases": [
    {
      "id": "resized-native-next",
      "required": "Only limit changes; opaque cursor spelling and snapshot/authorization stay fixed."
    },
    {
      "id": "no-overfetch",
      "required": "Page size 50 with total budget 7 requests limit=7 before receiving a page."
    },
    {
      "id": "empty-nonterminal",
      "required": "Zero items with next URL remains non-exhausted; meaningful progress or explicit refusal."
    },
    {
      "id": "provider-overflow",
      "required": "Response exceeds requested limit: refuse that page before emitting any of its rows."
    },
    {
      "id": "terminal-priority",
      "required": "Observed native end beats coincident total/page cap."
    },
    {
      "id": "interrupted-tail",
      "required": "Mid-page emitted prefix has no invented continuation after undelivered tail."
    },
    {
      "id": "complete-boundary-failure",
      "required": "After complete pages, failure may preserve last exact issued continuation."
    },
    {
      "id": "wrong-empty-kind",
      "required": "Link command refuses empty Bead collection by declared kind."
    },
    {
      "id": "incident-kind",
      "required": "HTTP point subject bead and top-level collection link remain distinct."
    },
    {
      "id": "bodyless-get",
      "required": "304 has no data/items/completion; query/auth/erasure checks occur first."
    },
    {
      "id": "head-continuation",
      "required": "HEAD does not advance delivered-items checkpoint or accept total cap."
    },
    {
      "id": "conditional-unpaged",
      "required": "Explicit unpaged plus HTTP conditions refuses; automatic JSONL unpaged is suppressed."
    },
    {
      "id": "history-combinations",
      "required": "Existing application exact read requires advertisement and revision-only query."
    },
    {
      "id": "no-history-expansion",
      "required": "Ordinary snapshot support grants neither general History nor Type-definition transport."
    },
    {
      "id": "original-array-index",
      "required": "Include /properties/steps/0 and /properties/steps/2 evaluates original indexes, compacts once to a,c."
    },
    {
      "id": "ordinary-property-names",
      "required": "Properties-view id/type/revision/uri are authored data; Resource protection does not apply by name."
    },
    {
      "id": "optional-owned-plane",
      "required": "Omit whole ownedLinks is legal; represented References retain whole uri/revision."
    },
    {
      "id": "raw-output",
      "required": "Raw bytes omit projection/completion framing; status/stderr remain necessary."
    },
    {
      "id": "continuation-ownership",
      "required": "No ambient-default assumption/path stripping/foreign credential forwarding."
    },
    {
      "id": "type-sentinel",
      "required": "Bare --type any omits; explicit URI ending /any remains ordinary identity."
    }
  ],
  "scopeExampleNote": "Scope example uses staged inherited read/profile navigation only to check transport/framing; it selects no final profile or Type inventory payload."
}
