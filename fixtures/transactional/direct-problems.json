        },
        "schema": "#/$defs/transactionalProblem",
        "body": {
          "type": "https://github.com/gastownhall/bdp/problems/request",
          "title": "Idempotency-Key field is required",
          "status": 400,
          "code": "malformed-request",
          "retry": "never"
        }
      }
    },
    {
      "id": "batch-unpaired-surrogate",
      "condition": "The raw request text is well-formed JSON but violates the protocol I-JSON string/object contract before key lookup or execution. bodyText preserves the exact wire text because parsing would erase duplicate-name evidence.",
