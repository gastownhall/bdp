              "code": "idempotency-in-progress",
              "retry": "after-delay",
              "retryAfter": 1,
              "operationIndex": 1
            },
            {
              "type": "https://github.com/gastownhall/bdp/problems/gone",
              "title": "Receipt detail expired",
              "status": 410,
              "code": "idempotency-expired",
              "retry": "never",
              "operationIndex": 2,
